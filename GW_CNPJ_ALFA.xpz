      <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
        <Source><![CDATA[Event Start
	GXMask1.AttachControl = &CPFCNPJ.InternalName
Endevent

Event 'Validar'

	ValidarDocumento(&CPFCNPJ, &Valido, &Tipo, &Formatado)	
	If &Valido
     	Msg("Documento válido: " + &Formatado)
	Else
		Msg("Documento inválido: " + &Formatado)
   	EndIf

EndEvent
]]></Source>
