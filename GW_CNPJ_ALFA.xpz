    <Object parentGuid="b2d1a572-944f-4586-9d16-4133496e4a78" user="GLAUBERMACIEL\glaub" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-02-15T01:50:28.0000000Z" checksum="26c26768bae1a8f92bd5b8912f4e0818" fullyQualifiedName="Formatar_CNPJ" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="92ca5795-101b-48e0-963a-34760528adfc" name="Formatar_CNPJ" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Formatar_CNPJ" parent="CPF_CNPJ" parentType="00000000-0000-0000-0000-000000000008">
      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[// Código:
&Limpo = &CNPJ.Trim().ToUpper()
&Limpo = &Limpo.Replace(".","").Replace("/","").Replace("-","").Replace(" ","")

If &Limpo.Length() = 14
   &CNPJFormatado = &Limpo.Substring(1,2) + "." + &Limpo.Substring(3,3) + "." + &Limpo.Substring(6,3) + "/" + &Limpo.Substring(9,4) + "-" + &Limpo.Substring(13,2)
Else
   &CNPJFormatado = &CNPJ
EndIf
]]></Source>
