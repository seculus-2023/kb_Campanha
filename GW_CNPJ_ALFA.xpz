    <Object parentGuid="b2d1a572-944f-4586-9d16-4133496e4a78" user="GLAUBERMACIEL\glaub" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-02-15T23:15:44.0000000Z" checksum="cf4152546a94a4eca68d9d804273da31" fullyQualifiedName="ValidarDocumento" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="802fc152-a2a2-46a8-8fea-c0713e8daf98" name="ValidarDocumento" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Validar Documento" parent="CPF_CNPJ" parentType="00000000-0000-0000-0000-000000000008">
      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[// Código:
&Limpo = &Documento.Trim().ToUpper()
&Limpo = &Limpo.Replace(".","").Replace("/","").Replace("-","").Replace(" ","")

Do Case
	Case &Limpo.Length() = 11
   		&Tipo = "CPF"
		Validar_CPF(&Documento, &Valido)
		If &Valido
			Formatar_CPF(&Documento, &Formatado)
		Else
			&Formatado = &Documento
		EndIf

	Case &Limpo.Length() = 14
		&Tipo = "CNPJ"
		Validar_CNPJ(&Documento, &Valido)
		If &Valido
			Formatar_CNPJ(&Documento, &Formatado)
		Else
			&Formatado = &Documento
		EndIf
	OtherWise
   		&Valido = False
   		&Tipo = "INVALIDO"
   		&Formatado = &Documento
EndCase
]]></Source>
