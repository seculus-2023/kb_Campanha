    <Object parentGuid="b2d1a572-944f-4586-9d16-4133496e4a78" user="GLAUBERMACIEL\glaub" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-02-15T23:01:32.0000000Z" checksum="8688cce6dc0384ea97243200ba1e08f1" fullyQualifiedName="Validar_CPF" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="072f4575-7d5a-441d-b5af-cfbc75cf2145" name="Validar_CPF" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Validar_CPF" parent="CPF_CNPJ" parentType="00000000-0000-0000-0000-000000000008">
      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[// Código:
&Limpo = &CPF.Trim().Replace(".","").Replace("-","")

If &Limpo.Length() <> 11
   &Valido = False
   Return
EndIf

&TodosIguais = True
For &i = 2 To 11
   If &Limpo.Substring(&i, 1) <> &Limpo.Substring(1, 1)
      &TodosIguais = False
      Exit
   EndIf
EndFor

If &TodosIguais
   &Valido = False
   Return
EndIf

&Soma = 0
&Soma += Val(&Limpo.Substring(1,1)) * 10
&Soma += Val(&Limpo.Substring(2,1)) * 9
&Soma += Val(&Limpo.Substring(3,1)) * 8
&Soma += Val(&Limpo.Substring(4,1)) * 7
&Soma += Val(&Limpo.Substring(5,1)) * 6
&Soma += Val(&Limpo.Substring(6,1)) * 5
&Soma += Val(&Limpo.Substring(7,1)) * 4
&Soma += Val(&Limpo.Substring(8,1)) * 3
&Soma += Val(&Limpo.Substring(9,1)) * 2

&Resto = Mod(&Soma * 10, 11)
If &Resto = 10
   &Resto = 0
EndIf

If &Resto <> Val(&Limpo.Substring(10,1))
   &Valido = False
   Return
EndIf

&Soma.SetEmpty()
&Soma += Val(&Limpo.Substring(1,1)) * 11
&Soma += Val(&Limpo.Substring(2,1)) * 10
&Soma += Val(&Limpo.Substring(3,1)) * 9
&Soma += Val(&Limpo.Substring(4,1)) * 8
&Soma += Val(&Limpo.Substring(5,1)) * 7
&Soma += Val(&Limpo.Substring(6,1)) * 6
&Soma += Val(&Limpo.Substring(7,1)) * 5
&Soma += Val(&Limpo.Substring(8,1)) * 4
&Soma += Val(&Limpo.Substring(9,1)) * 3
&Soma += Val(&Limpo.Substring(10,1)) * 2

&Resto = Mod(&Soma * 10, 11)
If &Resto = 10
   &Resto = 0
EndIf

If &Resto <> Val(&Limpo.Substring(11,1))
   &Valido = False
   Return
EndIf

&Valido = True
]]></Source>
        <Properties><Property><Name>IsDefault</Name><Value>False</Value></Property></Properties>
