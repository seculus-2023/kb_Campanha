    <Object parentGuid="b2d1a572-944f-4586-9d16-4133496e4a78" user="GLAUBERMACIEL\glaub" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-02-15T01:49:48.0000000Z" checksum="4f5393cabcf35d7eae1d10ce16ce311d" fullyQualifiedName="Formatar_CPF" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="e95c3088-3a43-48b6-9cce-a6114f05132d" name="Formatar_CPF" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Formatar_CPF" parent="CPF_CNPJ" parentType="00000000-0000-0000-0000-000000000008">
      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[// Código:
&Limpo = &CPF.Trim().Replace(".","").Replace("-","")

If &Limpo.Length() = 11
   &CPFFormatado = &Limpo.Substring(1,3) + "." + &Limpo.Substring(4,3) + "." + &Limpo.Substring(7,3) + "-" + &Limpo.Substring(10,2)
Else
   &CPFFormatado = &CPF
EndIf
]]></Source>
