  <Objects>
    <Object parentGuid="b2d1a572-944f-4586-9d16-4133496e4a78" user="GLAUBERMACIEL\glaub" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-02-15T22:59:47.0000000Z" checksum="1e2949ee37f1a52dd5c309bdffb1f34c" fullyQualifiedName="Validar_CNPJ" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="16574f4c-d446-43e7-b263-68b72d427037" name="Validar_CNPJ" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Validar_CNPJ" parent="CPF_CNPJ" parentType="00000000-0000-0000-0000-000000000008">
      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[// Código:
&Limpo = &CNPJ.Trim().ToUpper()
&Limpo = &Limpo.Replace(".","").Replace("/","").Replace("-","").Replace(" ","")

If &Limpo.Length() <> 14
   &Valido = False
   Return
EndIf

&TodosIguais = True
For &i = 2 To 14
   If &Limpo.Substring(&i, 1) <> &Limpo.Substring(1, 1)
      &TodosIguais = False
      Exit
   EndIf
EndFor

If &TodosIguais
   &Valido = False
   Return
EndIf

&Soma = 0
&Soma = &Soma + (Asc(&Limpo.Substring(1,1)) - 48) * 5
&Soma = &Soma + (Asc(&Limpo.Substring(2,1)) - 48) * 4
&Soma = &Soma + (Asc(&Limpo.Substring(3,1)) - 48) * 3
&Soma = &Soma + (Asc(&Limpo.Substring(4,1)) - 48) * 2
&Soma = &Soma + (Asc(&Limpo.Substring(5,1)) - 48) * 9
&Soma = &Soma + (Asc(&Limpo.Substring(6,1)) - 48) * 8
&Soma = &Soma + (Asc(&Limpo.Substring(7,1)) - 48) * 7
&Soma = &Soma + (Asc(&Limpo.Substring(8,1)) - 48) * 6
&Soma = &Soma + (Asc(&Limpo.Substring(9,1)) - 48) * 5
&Soma = &Soma + (Asc(&Limpo.Substring(10,1)) - 48) * 4
&Soma = &Soma + (Asc(&Limpo.Substring(11,1)) - 48) * 3
&Soma = &Soma + (Asc(&Limpo.Substring(12,1)) - 48) * 2
&Resto = Mod(&Soma, 11)

If &Resto < 2
   &DV1 = 0
Else
   &DV1 = 11 - &Resto
EndIf

If &DV1 <> (Asc(&Limpo.Substring(13,1)) - 48)
   &Valido = False
   Return
EndIf

&Soma = 0
&Soma = &Soma + (Asc(&Limpo.Substring(1,1)) - 48) * 6
&Soma = &Soma + (Asc(&Limpo.Substring(2,1)) - 48) * 5
&Soma = &Soma + (Asc(&Limpo.Substring(3,1)) - 48) * 4
&Soma = &Soma + (Asc(&Limpo.Substring(4,1)) - 48) * 3
&Soma = &Soma + (Asc(&Limpo.Substring(5,1)) - 48) * 2
&Soma = &Soma + (Asc(&Limpo.Substring(6,1)) - 48) * 9
&Soma = &Soma + (Asc(&Limpo.Substring(7,1)) - 48) * 8
&Soma = &Soma + (Asc(&Limpo.Substring(8,1)) - 48) * 7
&Soma = &Soma + (Asc(&Limpo.Substring(9,1)) - 48) * 6
&Soma = &Soma + (Asc(&Limpo.Substring(10,1)) - 48) * 5
&Soma = &Soma + (Asc(&Limpo.Substring(11,1)) - 48) * 4
&Soma = &Soma + (Asc(&Limpo.Substring(12,1)) - 48) * 3
&Soma = &Soma + (Asc(&Limpo.Substring(13,1)) - 48) * 2

&Resto = Mod(&Soma, 11)

If &Resto < 2
   &DV2 = 0
Else
   &DV2 = 11 - &Resto
EndIf

If &DV2 <> (Asc(&Limpo.Substring(14,1)) - 48)
   &Valido = False
   Return
EndIf

&Valido = True
]]></Source>
        <Properties><Property><Name>IsDefault</Name><Value>False</Value></Property></Properties>
